<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermann_g5">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0390386052234 -1.34619604261e-17 0.0269915228193" rpy="0 0 0" />
      <mass value="1.3258717866780132" />
      <inertia ixx="0.000665" iyy="0.001083" izz="0.001606" ixy="-0.0" iyz="-0.0" ixz="1.5e-05" />
    </inertial>
    <visual>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="orange">
        <color rgba="0.95 0.25 0.025 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.04 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  <link name="b_wheel_l_1">
    <inertial>
      <origin xyz="-6.938893903907228e-18 0.0075 0.0" rpy="0 0 0" />
      <mass value="0.027390760948486005" />
      <inertia ixx="5e-06" iyy="9e-06" izz="5e-06" ixy="-0.0" iyz="0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="0.04 -0.05 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/b_wheel_l_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rubber">
        <color rgba="0.075 0.085 0.10 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.0075 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.015" />
      </geometry>
    </collision>
  </link>
  <link name="b_wheel_r_1">
    <inertial>
      <origin xyz="-6.938893903907228e-18 -0.007500000000000007 0.0" rpy="0 0 0" />
      <mass value="0.027390760948486005" />
      <inertia ixx="5e-06" iyy="9e-06" izz="5e-06" ixy="0.0" iyz="-0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="0.04 0.05 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/b_wheel_r_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rubber">
        <color rgba="0.075 0.085 0.10 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.0075 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.015" />
      </geometry>
    </collision>
  </link>
  <link name="Flag_1">
    <inertial>
      <origin xyz="-0.0004510005373003709 1.409525652390974e-17 0.007733133034288214" rpy="0 0 0" />
      <mass value="0.005640353210480148" />
      <inertia ixx="1e-7" iyy="1e-7" izz="1e-7" ixy="-0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="0.0275 -0.0 -0.06" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/Flag_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="yellow">
        <color rgba="0.95 0.78 0.035 1" />
      </material>
    </visual>
  </link>
  <link name="f_steer_l_1">
    <inertial>
      <origin xyz="-4.182695856336238e-13 -0.0024999999999999883 -6.938893903907228e-18" rpy="0 0 0" />
      <mass value="0.0004932300466135765" />
      <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="-0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.04 0.05 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/f_steer_l_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="steel">
        <color rgba="0.42 0.45 0.50 1" />
      </material>
    </visual>
  </link>
  <link name="f_wheel_r_1">
    <inertial>
      <origin xyz="-2.7755575615628914e-17 -0.007499999999999958 -6.938893903907228e-18" rpy="0 0 0" />
      <mass value="0.027390760948486005" />
      <inertia ixx="5e-06" iyy="9e-06" izz="5e-06" ixy="-0.0" iyz="-0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.04 0.055 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/f_wheel_r_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rubber">
        <color rgba="0.075 0.085 0.10 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.0075 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.015" />
      </geometry>
    </collision>
  </link>
  <link name="f_steer_r_1">
    <inertial>
      <origin xyz="-4.182695856336238e-13 0.0024999999999999883 0.0" rpy="0 0 0" />
      <mass value="0.0004932300466135765" />
      <inertia ixx="1e-8" iyy="1e-8" izz="1e-8" ixy="0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.04 -0.05 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/f_steer_r_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="steel">
        <color rgba="0.42 0.45 0.50 1" />
      </material>
    </visual>
  </link>
  <link name="f_wheel_l_1">
    <inertial>
      <origin xyz="-6.938893903907228e-18 0.0075 0.0" rpy="0 0 0" />
      <mass value="0.027390760948486005" />
      <inertia ixx="5e-06" iyy="9e-06" izz="5e-06" ixy="-0.0" iyz="-0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.04 -0.055 -0.025" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(arg mesh_dir)/f_wheel_l_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="rubber">
        <color rgba="0.075 0.085 0.10 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.0075 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="0.025" length="0.015" />
      </geometry>
    </collision>
  </link>
  <joint name="b_wheel_l_revolute" type="continuous">
    <origin xyz="0 0.05 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="b_wheel_l_1" />
    <axis xyz="0.0 1.0 0.0" />
  </joint>
  <joint name="b_wheel_r_revolute" type="continuous">
    <origin xyz="0 -0.05 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="b_wheel_r_1" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="flag_fixed" type="fixed">
    <origin xyz="0.0125 0 0.06" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Flag_1" />
  </joint>
  <joint name="f_steer_r_joint" type="revolute">
    <origin xyz="0.08 -0.05 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="f_steer_l_1" />
    <axis xyz="0.0 0.0 1.0" />
    <limit upper="0.610865" lower="-0.610865" effort="100" velocity="100" />
  </joint>
  <joint name="f_wheel_r_joint" type="continuous">
    <origin xyz="0.0 -0.005 0.0" rpy="0 0 0" />
    <parent link="f_steer_l_1" />
    <child link="f_wheel_r_1" />
    <axis xyz="0 1 0" />
  </joint>
  <joint name="f_steer_l_joint" type="revolute">
    <origin xyz="0.08 0.05 0.025" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="f_steer_r_1" />
    <axis xyz="0 0 1" />
    <limit upper="0.610865" lower="-0.610865" effort="100" velocity="100" />
  </joint>
  <joint name="f_wheel_l_joint" type="continuous">
    <origin xyz="0.0 0.005 0.0" rpy="0 0 0" />
    <parent link="f_steer_r_1" />
    <child link="f_wheel_l_1" />
    <axis xyz="0.0 1.0 -0.0" />
  </joint>
  <xacro:arg name="mesh_dir" default="$(find ackermann_g5)/meshes" />
  <xacro:arg name="lidar" default="false" />
  <gazebo reference="b_wheel_l_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="b_wheel_r_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="f_wheel_r_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="f_wheel_l_1">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <xacro:if value="$(arg lidar)">
    <link name="lidar_link">
      <inertial>
        <mass value="0.015" />
        <inertia ixx="2e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="3e-6" />
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.018" length="0.015" />
        </geometry>
      </visual>
    </link>
    <joint name="lidar_fixed" type="fixed">
      <parent link="base_link" />
      <child link="lidar_link" />
      <origin xyz="0.060 0 0.090" rpy="0 0 0" />
    </joint>
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <topic>/g5/scan</topic>
        <gz_frame_id>lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>8</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:if>
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>b_wheel_l_revolute</left_joint>
      <right_joint>b_wheel_r_revolute</right_joint>
      <left_steering_joint>f_steer_l_joint</left_steering_joint>
      <right_steering_joint>f_steer_r_joint</right_steering_joint>
      <wheel_base>0.080</wheel_base>
      <wheel_separation>0.115</wheel_separation>
      <kingpin_width>0.100</kingpin_width>
      <wheel_radius>0.025</wheel_radius>
      <steering_limit>0.40</steering_limit>
      <min_velocity>-0.8</min_velocity>
      <max_velocity>0.8</max_velocity>
      <min_acceleration>-0.5</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
      <steer_p_gain>9</steer_p_gain>
      <topic>/g5/cmd_vel</topic>
      <odom_topic>/g5/odom</odom_topic>
      <tf_topic>/g5/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/g5/ground_truth</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/g5/joint_states</topic>
    </plugin>
  </gazebo>
</robot>